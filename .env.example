# Legajo frontend environment (TRD §14.4). Copy to `.env` for local overrides.
# Never commit real values; production values live in the Vercel project settings.

# Base URL of the Legajo API (the Render service in production), with no trailing slash.
# Development: leave empty to use the Vite `/api` proxy to http://localhost:8080.
# Production builds fail on purpose if this is empty (src/infrastructure/env.ts).
VITE_API_BASE_URL=
